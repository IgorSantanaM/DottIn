@page "/register"
@inject IAuthApi AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<style>
    .login-container {
        position: relative;
        height: 100vh;
        width: 100vw;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #0B132A;
        font-family: 'Inter', sans-serif;
        padding: 24px;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .login-container::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(37, 99, 235, 0.04) 1px, transparent 1px), 
                          linear-gradient(90deg, rgba(37, 99, 235, 0.04) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(circle 500px at 50% 50%, black 20%, transparent 100%);
        -webkit-mask-image: radial-gradient(circle 500px at 50% 50%, black 20%, transparent 100%);
        pointer-events: none;
        z-index: 0;
    }

    .login-container::after {
        content: '';
        position: absolute;
        width: 450px;
        height: 450px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(37, 99, 235, 0.08) 0%, transparent 70%);
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        pointer-events: none;
        z-index: 0;
    }

    .login-content-wrap {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        gap: 24px;
        margin: auto 0;
    }

    .brand-logo-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .brand-logo-mark {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 30px rgba(37, 99, 235, 0.35), 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .brand-logo-mark svg {
        width: 28px;
        height: 28px;
        color: white;
    }

    .brand-wordmark {
        display: flex;
        align-items: baseline;
        justify-content: center;
    }

    .brand-wordmark-text {
        font-size: 26px;
        font-weight: 700;
        color: #F8FAFC;
        letter-spacing: -0.5px;
    }

    .brand-wordmark-dot {
        font-size: 26px;
        font-weight: 800;
        color: #2563EB;
    }

    .brand-subtitle-text {
        font-size: 11px;
        font-weight: 600;
        color: #64748B;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-top: 2px;
    }

    .login-card {
        background: rgba(17, 28, 68, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        border-radius: 24px !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4) !important;
        padding: 12px;
    }

    .step-title {
        color: #F8FAFC !important;
        font-weight: 600 !important;
    }

    .step-desc {
        color: #94A3B8 !important;
    }

    .login-container .mud-input {
        color: #F8FAFC !important;
        background: rgba(11, 19, 42, 0.6) !important;
    }
    .login-container .mud-input-outlined-border {
        border-color: rgba(255, 255, 255, 0.12) !important;
        border-radius: 14px !important;
    }
    .login-container .mud-input-label {
        color: #64748B !important;
    }
    .login-container .mud-focused .mud-input-label {
        color: #60A5FA !important;
    }
    .login-container .mud-input-adornment .mud-icon-root {
        color: #475569 !important;
    }

    .btn-gradient {
        background: linear-gradient(90deg, #2563EB, #1D4ED8) !important;
        color: #FFFFFF !important;
        border-radius: 14px !important;
        font-weight: 600 !important;
        text-transform: none !important;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25) !important;
    }

    .btn-text-custom {
        color: #94A3B8 !important;
        text-transform: none !important;
        font-weight: 500 !important;
        border-radius: 12px !important;
    }
    .btn-text-custom:hover {
        color: #F8FAFC !important;
        background: rgba(255, 255, 255, 0.04) !important;
    }

    .login-footer-wrap {
        text-align: center;
        margin-top: auto;
        padding-top: 16px;
    }
</style>

<div class="login-container">
    <div class="login-content-wrap">
        
        <div class="brand-logo-wrap">
            <div class="brand-logo-mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <polyline points="12 7 12 12 15.5 14" />
                </svg>
            </div>
            <div class="text-center">
                <div class="brand-wordmark">
                    <span class="brand-wordmark-text">Dott</span><span class="brand-wordmark-dot">In</span>
                </div>
                <div class="brand-subtitle-text">Controle de Ponto Inteligente</div>
            </div>
        </div>

        <MudCard Class="login-card" Elevation="0">
            <MudCardContent>
                <div class="step-content">
                    <MudText Typo="Typo.h6" Class="step-title mb-1">Criar Conta</MudText>
                    <MudText Typo="Typo.body2" Class="step-desc mb-5">Preencha seus dados para se registrar.</MudText>
                    
                    <MudTextField @bind-Value="_companyCode"
                                  Label="Código da Empresa"
                                  Placeholder="ex: acme-corp"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Business"
                                  FullWidth="true"
                                  Class="mb-4" />

                    <MudTextField @bind-Value="_cpf"
                                  Label="CPF"
                                  Placeholder="Apenas números"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge"
                                  InputType="InputType.Text"
                                  MaxLength="11"
                                  FullWidth="true"
                                  Class="mb-4" />

                    <MudTextField @bind-Value="_password"
                                  Label="Senha"
                                  Placeholder="*********"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Lock"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  FullWidth="true"
                                  Class="mb-5">
                        <AdornmentContent>
                            <MudIconButton Icon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                           OnClick="@(() => _showPassword = !_showPassword)"
                                           Edge="Edge.End" Style="color: #475569;" />
                        </AdornmentContent>
                    </MudTextField>

                    <MudButton Variant="Variant.Filled"
                               Class="btn-gradient"
                               FullWidth="true"
                               Size="Size.Large"
                               Disabled="@(!IsFormValid() || _isLoading)"
                               OnClick="RegisterAsync">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Registrar
                    </MudButton>

                    <MudButton Variant="Variant.Text"
                               Class="btn-text-custom mt-3"
                               FullWidth="true"
                               OnClick='@(() => Navigation.NavigateTo("/login"))'>
                        Já tem uma conta? Faça login
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>

        <div class="login-footer-wrap">
            <MudText Typo="Typo.caption" Style="color: #475569; font-weight: 500;">
                Versão 1.0.0 | &copy; 2026 DottIn
            </MudText>
        </div>
    </div>
</div>

@code {
    private string _companyCode = "";
    private string _cpf = "";
    private string _password = "";
    private bool _showPassword = false;
    private bool _isLoading = false;

    private bool IsFormValid() => 
        !string.IsNullOrWhiteSpace(_companyCode) &&
        !string.IsNullOrWhiteSpace(_cpf) && 
        _cpf.Trim().Length == 11 &&
        !string.IsNullOrWhiteSpace(_password);

    private async Task RegisterAsync()
    {
        if (!IsFormValid()) return;

        _isLoading = true;
        try
        {
            // TODO: Call your actual registration API endpoint here
            // var request = new RegisterRequest(_cpf.Trim(), _password, _companyCode);
            // await AuthApi.RegisterAsync(request);

            await Task.Delay(1000); // Simulate network request for now
            Snackbar.Add("Registro realizado com sucesso!", Severity.Success);
            Navigation.NavigateTo("/login");
        }
        catch (Exception)
        {
            Snackbar.Add("Erro ao registrar. Tente novamente.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
