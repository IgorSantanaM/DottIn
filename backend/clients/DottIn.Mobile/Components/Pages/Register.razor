@page "/register"
@inject IAuthApi Auth
@inject MobileSessionService Session
@inject NavigationManager Navigation

<MudContainer MaxWidth="MaxWidth.Small" Class="pa-4">
    <MudText Typo="Typo.h5">Criar conta de proprietário</MudText>
    <MudText Class="mb-4">Depois, cadastre sua empresa para começar.</MudText>
    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    <MudTextField @bind-Value="_name" Label="Nome completo" Variant="Variant.Outlined" Immediate="true" />
    <MudTextField @bind-Value="_cpf" Label="CPF" Variant="Variant.Outlined" MaxLength="14" Immediate="true" />
    <MudTextField @bind-Value="_password" Label="Senha (mínimo 6 caracteres)" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" />
    <MudTextField @bind-Value="_confirmation" Label="Confirmar senha" InputType="InputType.Password" Variant="Variant.Outlined" Immediate="true" />
    <MudButton OnClick="RegisterAsync" Disabled="@(_busy || !Valid)" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">
        @(_busy ? "Criando conta…" : "Criar conta")
    </MudButton>
    <MudButton Href="/login" Disabled="_busy">Já tenho conta</MudButton>
</MudContainer>

@code {
    private string _name = "", _cpf = "", _password = "", _confirmation = "";
    private bool _busy;
    private string? _error;
    private OwnerRegistrationResponse? _registered;
    private bool Valid => !string.IsNullOrWhiteSpace(_name) && ManagementRules.Digits(_cpf).Length == 11
        && _password.Length >= 6 && _password == _confirmation;
    private async Task RegisterAsync()
    {
        if (_busy || !Valid) return;
        _busy = true; _error = null;
        try
        {
            var result = _registered ??= await Auth.RegisterOwnerAsync(new(_name.Trim(), new(ManagementRules.Digits(_cpf), "CPF"), _password));
            await Session.AcceptAsync(new(result.AccessToken, result.RefreshToken, result.ExpiresAt, result.Employee, Guid.Empty, true, false));
            Navigation.NavigateTo(Session.LandingPage, replace: true);
        }
        catch (Exception ex) { _error = ManagementRules.Error(ex); }
        finally { _busy = false; }
    }
}
