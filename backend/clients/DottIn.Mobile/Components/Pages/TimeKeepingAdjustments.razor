@page "/management/adjustments"
@inject ITimeKeepingApi Api
@inject AppState State
@inject ISnackbar Snackbar

<MudContainer Class="pa-4">
    <MudText Typo="Typo.h5">Correções pendentes</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Analise solicitações sem alterar o registro original.</MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Nenhuma correção pendente.</MudAlert>
    }
    else
    {
        @foreach (var item in _items)
        {
            <MudCard Class="mb-3">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2">@item.EmployeeName · @Label(item.EntryType)</MudText>
                    <MudText Typo="Typo.body2">@item.ProposedTimestamp.ToString("dd/MM/yyyy HH:mm")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Reason</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="@(() => ReviewAsync(item, true))">Aprovar</MudButton>
                    <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="@(() => ReviewAsync(item, false))">Rejeitar</MudButton>
                </MudCardActions>
            </MudCard>
        }
    }
</MudContainer>

@code {
    private readonly List<TimeKeepingAdjustmentItem> _items = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!State.IsOwner) return;
        try { _items.AddRange(await Api.GetAdjustmentsAsync(State.BranchId, "Pending")); }
        catch (Exception ex) { Snackbar.Add(ManagementRules.Error(ex), Severity.Error); }
        finally { _loading = false; }
    }

    private async Task ReviewAsync(TimeKeepingAdjustmentItem item, bool approve)
    {
        try
        {
            await Api.ReviewAdjustmentAsync(State.BranchId, item.Id, new ReviewTimeKeepingAdjustmentRequest(approve, null));
            _items.Remove(item);
            Snackbar.Add(approve ? "Correção aprovada." : "Correção rejeitada.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ManagementRules.Error(ex), Severity.Error); }
    }

    private static string Label(string type) => type switch
    {
        "ClockIn" => "Entrada", "BreakStart" => "Início do intervalo",
        "BreakEnd" => "Fim do intervalo", "ClockOut" => "Saída", _ => type
    };
}
