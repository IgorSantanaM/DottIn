<div class="mobile-loading" role="status" aria-live="polite" aria-label="@Message">
    <div class="mobile-loading__ambient"></div>
    <div class="mobile-loading__content">
        <div class="mobile-loading__mark-wrap">
            <div class="mobile-loading__orbit"></div>
            <div class="mobile-loading__mark">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="8.5" />
                    <path d="M12 7.5v4.8l3.3 2" />
                </svg>
            </div>
        </div>
        <div class="mobile-loading__wordmark">Dott<span>In</span></div>
        <div class="mobile-loading__message">@Message</div>
        <div class="mobile-loading__track"><span></span></div>
        <div class="mobile-loading__hint">Protegendo seus dados e sua sessão</div>
    </div>
</div>

@code {
    [Parameter] public string Message { get; set; } = "Preparando seu acesso";
}

<style>
    .mobile-loading { position: fixed; inset: 0; z-index: 9998; display: grid; place-items: center; overflow: hidden; color: #f8fafc; background: radial-gradient(circle at 50% 30%, rgba(59,130,246,.2), transparent 25rem), linear-gradient(160deg,#07101f,#0b1530 68%,#111d3b); font-family: Inter,system-ui,sans-serif; }
    .mobile-loading::before { content:""; position:absolute; inset:0; opacity:.28; background-image:linear-gradient(rgba(148,163,184,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(148,163,184,.08) 1px,transparent 1px); background-size:44px 44px; mask-image:radial-gradient(circle at center,#000,transparent 75%); }
    .mobile-loading__ambient { position:absolute; width:120vw; max-width:560px; aspect-ratio:1; border-radius:50%; background:rgba(37,99,235,.09); filter:blur(64px); animation:mobile-loading-breathe 2.8s ease-in-out infinite; }
    .mobile-loading__content { position:relative; width:min(78vw,300px); display:flex; flex-direction:column; align-items:center; text-align:center; }
    .mobile-loading__mark-wrap { position:relative; width:82px; height:82px; display:grid; place-items:center; }
    .mobile-loading__orbit { position:absolute; inset:0; border:1px solid rgba(96,165,250,.22); border-top-color:#60a5fa; border-radius:50%; animation:mobile-loading-spin 1.6s linear infinite; }
    .mobile-loading__mark { width:56px; height:56px; display:grid; place-items:center; border-radius:18px; color:#fff; background:linear-gradient(145deg,#3b82f6,#1d4ed8); box-shadow:0 18px 48px rgba(37,99,235,.42); }
    .mobile-loading__mark svg { width:29px; height:29px; }
    .mobile-loading__wordmark { margin-top:22px; font-size:28px; font-weight:750; letter-spacing:-.04em; }
    .mobile-loading__wordmark span { color:#60a5fa; }
    .mobile-loading__message { margin-top:12px; color:#cbd5e1; font-size:14px; font-weight:500; }
    .mobile-loading__track { width:100%; height:4px; margin-top:28px; overflow:hidden; border-radius:999px; background:rgba(148,163,184,.13); }
    .mobile-loading__track span { display:block; width:42%; height:100%; border-radius:inherit; background:linear-gradient(90deg,transparent,#60a5fa,#2563eb,transparent); animation:mobile-loading-slide 1.45s ease-in-out infinite; }
    .mobile-loading__hint { margin-top:13px; color:#64748b; font-size:11px; }
    @@keyframes mobile-loading-spin { to { transform:rotate(360deg); } }
    @@keyframes mobile-loading-slide { from { transform:translateX(-110%); } to { transform:translateX(240%); } }
    @@keyframes mobile-loading-breathe { 50% { transform:scale(1.08); opacity:.7; } }
    @@media (prefers-reduced-motion:reduce) { .mobile-loading__orbit,.mobile-loading__track span,.mobile-loading__ambient { animation:none; } }
</style>
