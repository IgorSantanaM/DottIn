@inherits LayoutComponentBase
@inject AdminState State
@inject AdminApiClient Api
@inject NavigationManager Navigation
@implements IDisposable

@if (!State.IsAuthenticated)
{
    @Body
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Dense="true" Fixed="true" Class="dottin-appbar"
                   Style="background-color: var(--mud-palette-appbar-background); color: var(--mud-palette-appbar-text);">
            @if (State.CanAccessOperationalModules && State.Role != "Accountant")
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               Edge="Edge.Start" OnClick="@(() => _desktopDrawerOpen = !_desktopDrawerOpen)"
                               Class="dottin-desktop-menu" aria-label="Abrir ou fechar navegação" aria-expanded="@_desktopDrawerOpen" />
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                               Edge="Edge.Start" OnClick="@(() => _mobileDrawerOpen = !_mobileDrawerOpen)"
                               Class="dottin-mobile-menu" aria-label="Abrir ou fechar navegação" aria-expanded="@_mobileDrawerOpen" />
            }
            <DottInLogo Dark="@State.IsDarkMode" Height="32" />
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ml-2 dottin-role-chip">@State.RoleLabel</MudChip>
            <MudSpacer />
            <MudTooltip Text="@(State.IsDarkMode ? "Modo claro" : "Modo escuro")">
                <MudIconButton Icon="@(State.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit" OnClick="State.ToggleDarkMode"
                               aria-label="@(State.IsDarkMode ? "Ativar modo claro" : "Ativar modo escuro")" />
            </MudTooltip>
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Dense="true"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Disabled="true">
                    <div style="min-width: 180px;">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@State.User?.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(State.Role == "Accountant" ? "Contador" : "Administrador")</MudText>
                    </div>
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Sair</MudMenuItem>
            </MudMenu>
        </MudAppBar>

        @if (State.CanAccessOperationalModules)
        {
            <MudDrawer @bind-Open="_desktopDrawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always"
                       Variant="DrawerVariant.Mini" OpenMiniOnHover="true" Class="dottin-desktop-navigation">
                <OperationalNavMenu CanViewEmployees="@State.CanViewEmployees" IsOwner="@State.IsOwner" />
            </MudDrawer>
            <MudDrawer @bind-Open="_mobileDrawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always"
                       Variant="DrawerVariant.Temporary" Class="dottin-mobile-navigation">
                <OperationalNavMenu CanViewEmployees="@State.CanViewEmployees" IsOwner="@State.IsOwner" />
            </MudDrawer>
        }

        <MudMainContent Class="dottin-main-content"
                        Style="background: var(--mud-palette-background);">
            @if (!State.SessionPersistenceAvailable)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4" role="status">
                    O navegador bloqueou o armazenamento local. A sessão atual funciona, mas será necessário entrar novamente após recarregar a página.
                </MudAlert>
            }
            @Body
        </MudMainContent>
    </MudLayout>
}

@code {
    // CSS selects the appropriate navigation instantly, including during rotation.
    // Independent open states prevent the desktop drawer from opening the phone menu.
    private bool _desktopDrawerOpen = true;
    private bool _mobileDrawerOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _mobileDrawerOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private async Task Logout()
    {
        await Api.LogoutAsync();
        await State.LogoutAsync();
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
