@inject AdminState State
@inject AuthService Auth
@inject OperationalAccessService OperationalAccess
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="State.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (_initializing)
{
    <AppLoadingScreen Message="Abrindo DottIn" />
}
else
{
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <OperationalRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
}

@code {
    private bool _initializing = true;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += HandleStateChange;
        var restored = false;
        try
        {
            restored = await Auth.RestoreLocalSessionAsync();
        }
        finally
        {
            _initializing = false;
        }

        if (restored)
            _ = CompleteSessionRestoreAsync();
    }

    private async Task CompleteSessionRestoreAsync()
    {
        await Auth.ValidateRestoredSessionAsync();
        if (State.IsSessionReady)
            await OperationalAccess.RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void HandleStateChange() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.OnChange -= HandleStateChange;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            PrimaryDarken = "#1D4ED8",
            PrimaryLighten = "#3B82F6",
            Secondary = "#64748B",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F1F5F9",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1E293B",
            DrawerBackground = "#1E293B",
            DrawerText = "#CBD5E1",
            DrawerIcon = "#94A3B8",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#3B82F6",
            PrimaryDarken = "#2563EB",
            PrimaryLighten = "#60A5FA",
            Secondary = "#94A3B8",
            Success = "#34D399",
            Warning = "#FBBF24",
            Error = "#F87171",
            Background = "#0F172A",
            Surface = "#1E293B",
            AppbarBackground = "#1E293B",
            AppbarText = "#F1F5F9",
            DrawerBackground = "#0F172A",
            DrawerText = "#CBD5E1",
            DrawerIcon = "#94A3B8",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "sans-serif"] }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" }
    };
}
