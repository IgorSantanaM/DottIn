@inject AdminState State
@inject AuthService Auth
@inject OperationalAccessService OperationalAccess
@inject NavigationManager Navigation

@if (State.IsSessionRestoring)
{
    <LayoutView Layout="DefaultLayout">
        <section class="session-resume" aria-live="polite" aria-busy="true">
            @if (string.IsNullOrWhiteSpace(State.SessionError))
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Atualizando seus dados...</MudText>
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="110px" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@State.SessionError</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_retrying" OnClick="RetryAsync">
                    @(_retrying ? "Tentando novamente..." : "Tentar novamente")
                </MudButton>
            }
        </section>
    </LayoutView>
}
else if (CanRenderRoute)
{
    <RouteView @key="(State.EmployeeId, State.BranchId, RouteData.PageType)" RouteData="RouteData" DefaultLayout="DefaultLayout" />
}
else if (IsResolving)
{
    <LayoutView Layout="DefaultLayout">
        <div class="d-flex align-center justify-center" style="min-height: 50vh;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    </LayoutView>
}

<style>
    .session-resume { min-height:50vh; display:grid; align-content:start; gap:16px; max-width:980px; margin:0 auto; }
</style>

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    [Parameter]
    public Type? DefaultLayout { get; set; }

    private bool _retrying;

    private bool RequiresOperationalAccess
        => Attribute.IsDefined(
            RouteData.PageType,
            typeof(OperationalAccessRequiredAttribute));

    private bool CanRenderRoute
        => !RequiresOperationalAccess || State.CanAccessOperationalModules;

    private bool IsResolving
        => RequiresOperationalAccess
           && State.IsAuthenticated
           && !State.IsOperationalAccessResolved;

    private string? RedirectTarget
    {
        get
        {
            if (State.IsSessionRestoring || !RequiresOperationalAccess)
                return null;

            if (!State.IsAuthenticated)
                return "/";

            return State.IsOperationalAccessResolved && !State.CanAccessOperationalModules
                ? "/welcome"
                : null;
        }
    }

    private async Task RetryAsync()
    {
        _retrying = true;
        try
        {
            await Auth.ValidateRestoredSessionAsync();
            if (State.IsSessionReady)
                await OperationalAccess.RefreshAsync();
        }
        finally
        {
            _retrying = false;
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        var target = RedirectTarget;
        if (target is not null)
            Navigation.NavigateTo(target, replace: true);
    }
}