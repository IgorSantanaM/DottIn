@page "/payroll"
@attribute [OperationalAccessRequired]
@attribute [OwnerAccessRequired]
@inject AdminState State
@inject AdminApiClient Api
@inject BranchClockService Clock
@inject IDialogService Dialogs
@inject BrowserDownloadService Download
@inject ISnackbar Snackbar

<PageTitle>DottIn - Folha de pagamento</PageTitle>
<div class="dottin-page-header">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700;">Folha de pagamento</MudText>
        <MudText Color="Color.Secondary">Prepare os registros da unidade selecionada para o fechamento da folha.</MudText>
    </div>
    <MudButton Href="/timekeeping" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Schedule">Consultar registros</MudButton>
</div>

<MudPaper Elevation="0" Class="pa-4 my-4" Style="border-radius:12px;">
    <MudDatePicker @bind-Date="_month" Label="Mês de referência" DateFormat="MM/yyyy" OpenTo="OpenTo.Month"
                   FixDay="1" Variant="Variant.Outlined" Disabled="@(_initializing || _busy)" />
    @if (_initializing)
    { <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-3" /> }
    @if (_clockError is not null)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-3">@_clockError</MudAlert>
        <MudButton OnClick="InitializeMonthAsync">Tentar novamente</MudButton>
    }
    @if (_month is { } month)
    {
        var period = PayrollPeriod.FromMonth(month);
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Período: @period.Start.ToString("dd/MM/yyyy") a @period.End.ToString("dd/MM/yyyy")</MudText>
    }
</MudPaper>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    O DottIn prepara os dados de jornada. O cálculo de salários, descontos e o pagamento são realizados no seu sistema de folha, como o Domínio.
</MudAlert>

<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="pa-4" Style="border-radius:12px; height:100%; overflow-wrap:anywhere;">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">1. Conferir funcionários</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-3">Associe cada funcionário ao seu código interno no Domínio antes da importação.</MudText>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="MappingsAsync">Mapear funcionários</MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="pa-4" Style="border-radius:12px; height:100%; overflow-wrap:anywhere;">
            <MudIcon Icon="@Icons.Material.Filled.FileDownload" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">2. Exportar para Domínio</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-3">Confira empresa e rubricas e gere o arquivo de lançamentos do mês selecionado.</MudText>
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _month is null)" OnClick="DominioAsync">Exportar Domínio (.txt)</MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="pa-4" Style="border-radius:12px; height:100%; overflow-wrap:anywhere;">
            <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Primary" Class="mb-2" />
            <MudText Typo="Typo.h6">3. Conferir relatório</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-3">Baixe todos os registros do mês em CSV para conferência, sem limitação à página exibida.</MudText>
            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_busy || _month is null)" OnClick="CsvAsync">@(_exportingCsv ? "Exportando..." : "Exportar CSV (.csv)")</MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private DateTime? _month;
    private bool _initializing = true, _busy, _exportingCsv;
    private string? _clockError;

    protected override Task OnInitializedAsync() => InitializeMonthAsync();

    private async Task InitializeMonthAsync()
    {
        _initializing = true;
        _clockError = null;
        try
        {
            await Clock.SynchronizeAsync(State.BranchId);
            _month = new DateTime(Clock.Today.Year, Clock.Today.Month, 1);
        }
        catch { _clockError = "Não foi possível consultar o horário da unidade. Selecione o mês de referência ou tente novamente."; }
        finally { _initializing = false; }
    }

    private async Task MappingsAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var dialog = await Dialogs.ShowAsync<DominioMappingDialog>("Mapeamento Domínio",
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, BackdropClick = false });
            await dialog.Result;
        }
        finally { _busy = false; }
    }

    private async Task DominioAsync()
    {
        if (_busy || _month is null) return;
        _busy = true;
        try
        {
            var parameters = new DialogParameters<ExportDominioDialog> { { d => d.ReferenceMonth, _month } };
            var dialog = await Dialogs.ShowAsync<ExportDominioDialog>("Exportar Domínio", parameters,
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
            await dialog.Result;
        }
        finally { _busy = false; }
    }

    private async Task CsvAsync()
    {
        if (_busy || _month is not { } month) return;
        _busy = _exportingCsv = true;
        try
        {
            var period = PayrollPeriod.FromMonth(month);
            var bytes = await Api.ExportCsvAsync(State.BranchId, period.Start, period.End);
            await Download.DownloadAsync(bytes, $"folha_registros_{period.Start:yyyyMM}.csv", "text/csv;charset=utf-8");
            Snackbar.Add("Relatório mensal exportado.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = _exportingCsv = false; }
    }
}
