@using DottIn.Admin.Models
@inject AdminApiClient Api
@inject AdminState State
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.subtitle1" Class="mb-1">@Record.EmployeeName</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4">
            Jornada de @Record.WorkDate.ToString("dd/MM/yyyy"). O registro original será preservado.
        </MudText>

        <MudSelect T="string" @bind-Value="_entryType" Label="Tipo de marcação" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="@("ClockIn")">Entrada</MudSelectItem>
            <MudSelectItem Value="@("BreakStart")">Início do intervalo</MudSelectItem>
            <MudSelectItem Value="@("BreakEnd")">Fim do intervalo</MudSelectItem>
            <MudSelectItem Value="@("ClockOut")">Saída</MudSelectItem>
        </MudSelect>

        <MudSwitch T="bool" @bind-Value="_missingEntry" Label="Adicionar uma marcação que foi esquecida" Class="mb-3" />

        @if (!_missingEntry)
        {
            <MudSelect T="string" @bind-Value="_originalTimestamp" Label="Marcação original" Variant="Variant.Outlined" Class="mb-3">
                @foreach (var entry in MatchingEntries)
                {
                    <MudSelectItem Value="@(entry.Timestamp.ToString("O"))">@entry.Timestamp.ToString("dd/MM HH:mm")</MudSelectItem>
                }
            </MudSelect>
        }

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_proposedDate" Label="Nova data" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="_proposedTime" Label="Novo horário" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
        <MudTextField @bind-Value="_reason" Label="Justificativa" Lines="3" Counter="500"
                      Variant="Variant.Outlined" Class="mt-3" />

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="@(!CanSubmit || _saving)">
            Enviar para aprovação
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public TimeKeepingRecord Record { get; set; } = default!;

    private TimeKeepingDetails? _details;
    private string _entryType = "ClockOut";
    private string? _originalTimestamp;
    private bool _missingEntry;
    private DateTime? _proposedDate;
    private TimeSpan? _proposedTime;
    private string _reason = "";
    private bool _loading = true;
    private bool _saving;

    private IEnumerable<TimeEntryInfo> MatchingEntries
        => _details?.EntriesDto.Where(entry => entry.Type == _entryType) ?? [];

    private bool CanSubmit => _proposedDate.HasValue && _proposedTime.HasValue &&
                              _reason.Trim().Length is >= 5 and <= 500 &&
                              (_missingEntry || !string.IsNullOrWhiteSpace(_originalTimestamp));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _details = await Api.GetTimeKeepingByIdAsync(Record.Id);
            _missingEntry = !Record.ClockOut.HasValue;
            _proposedDate = Record.WorkDate.ToDateTime(TimeOnly.MinValue);
            _proposedTime = Record.ClockOut?.TimeOfDay ?? new TimeSpan(18, 0, 0);
            SelectFirstMatchingEntry();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectFirstMatchingEntry()
        => _originalTimestamp = MatchingEntries.FirstOrDefault()?.Timestamp.ToString("O");

    private async Task SubmitAsync()
    {
        if (!CanSubmit) return;
        _saving = true;
        try
        {
            var proposed = DateTime.SpecifyKind(_proposedDate!.Value.Date.Add(_proposedTime!.Value), DateTimeKind.Unspecified);
            DateTime? original = _missingEntry || string.IsNullOrWhiteSpace(_originalTimestamp)
                ? null
                : DateTime.Parse(_originalTimestamp, null, System.Globalization.DateTimeStyles.RoundtripKind);
            await Api.CreateTimeKeepingAdjustmentAsync(
                State.BranchId,
                Record.Id,
                new CreateTimeKeepingAdjustmentRequest(_entryType, original, proposed, _reason.Trim()));
            Snackbar.Add("Correção enviada para aprovação.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
