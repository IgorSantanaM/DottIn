@inject AdminApiClient Api
<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-3">Esta alteração encerra suas sessões. Depois, entre novamente.</MudAlert>
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mb-3" role="alert">@_error</MudAlert> }
        <MudForm @ref="_form">
            <MudTextField T="string" Label="Senha atual" @bind-Value="_current" InputType="InputType.Password"
                          Required="true" RequiredError="Informe sua senha atual." MaxLength="128" Disabled="_busy" autocomplete="current-password" />
            <MudTextField T="string" Label="@(Pin ? "Novo PIN (6 números)" : "Nova senha")" @bind-Value="_new"
                          InputType="InputType.Password" Validation="@(new Func<string, string?>(ValidateNew))" MaxLength="@(Pin ? 6 : 128)"
                          Required="true" RequiredError="Informe a nova credencial." Disabled="_busy" autocomplete="new-password" Class="my-3" />
            <MudTextField T="string" Label="Confirme a nova credencial" @bind-Value="_confirm" InputType="InputType.Password"
                          Validation="@(new Func<string, string?>(ValidateConfirmation))" Required="true" RequiredError="Confirme a credencial."
                          Disabled="_busy" autocomplete="new-password" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Cancelar</MudButton>
        <MudButton OnClick="SaveAsync" Disabled="_busy" Variant="Variant.Filled" Color="Color.Primary">@(_busy ? "Salvando..." : "Salvar e entrar novamente")</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public bool Pin { get; set; }
    private MudForm? _form;
    private string _current = "", _new = "", _confirm = "";
    private string? _error;
    private bool _busy;
    private string? ValidateNew(string value) => Pin
        ? value is { Length: 6 } && value.All(c => c >= '0' && c <= '9') ? null : "Informe exatamente 6 números."
        : !string.IsNullOrWhiteSpace(value) && value.Length is >= 10 and <= 128 && value.Any(char.IsUpper)
          && value.Any(char.IsLower) && value.Any(char.IsDigit) && value.Any(c => !char.IsLetterOrDigit(c))
            ? null : "Use de 10 a 128 caracteres, com maiúscula, minúscula, número e símbolo.";
    private string? ValidateConfirmation(string value) => value == _new ? null : "A confirmação não corresponde.";
    private void Cancel() { _current = _new = _confirm = ""; Dialog.Cancel(); }
    private async Task SaveAsync()
    {
        if (_busy || _form is null) return;
        await _form.Validate(); if (!_form.IsValid) return;
        _busy = true; _error = null;
        try
        {
            await Api.ChangeCredentialAsync(Pin, _current, _new);
            _current = _new = _confirm = "";
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException e) { _error = e.Message; }
        catch (Exception) { _error = "Não foi possível atualizar. Verifique sua conexão e tente novamente."; }
        finally { _busy = false; }
    }
}
