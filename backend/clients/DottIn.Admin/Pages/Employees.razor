@page "/employees"
@attribute [OperationalAccessRequired]
@inject AdminApiClient Api
@inject AdminState State
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>DottIn Admin - Funcionários</PageTitle>

<div style="display: flex; justify-content: space-between; align-items: center;" class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Funcionários</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Gerencie os funcionários da empresa
        </MudText>
    </div>
    @if (State.IsOwner)
    {
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CopyInviteLinkAsync">
                Copiar convite
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.SyncAlt" OnClick="ShowDominioMapping">
                Mapeamento Domínio
            </MudButton>
        </div>
    }
</div>

<MudPaper Elevation="0" Class="pa-5" Style="border-radius: 12px;">
    <div style="display: flex; justify-content: space-between; align-items: center;" class="mb-4">
        <MudTextField T="string" Value="_search" ValueChanged="@((string value) => OnSearchChanged(value))" Placeholder="Buscar funcionário..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" Style="max-width: 320px;" />
        <MudToggleGroup T="string" Value="_filter" ValueChanged="@((string value) => OnFilterChanged(value))" Color="Color.Primary" Size="Size.Small" Outlined="true">
            <MudToggleItem T="string" Value="@("all")">Todos</MudToggleItem>
            <MudToggleItem T="string" Value="@("active")">Ativos</MudToggleItem>
            <MudToggleItem T="string" Value="@("inactive")">Inativos</MudToggleItem>
        </MudToggleGroup>
    </div>

    @if (_loading)
    {
        <div style="display: flex; justify-content: center; padding: 48px;">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        <MudDataGrid Items="_employees" Dense="true" Hover="true" Striped="true"
                     SortMode="SortMode.Multiple">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Nome">
                    <CellTemplate>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                @context.Item.Name.FirstOrDefault()
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@context.Item.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatDocument(context.Item.Document)</MudText>
                            </div>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.BranchName" Title="Filial" />
                <PropertyColumn Property="x => x.StartWorkTime" Title="Horário">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">
                            @context.Item.StartWorkTime.ToString("HH:mm") - @context.Item.EndWorkTime.ToString("HH:mm")
                        </MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.HasFingerprint" Title="Biometria">
                    <CellTemplate>
                        <MudIcon Icon="@(context.Item.HasFingerprint ? Icons.Material.Filled.Fingerprint : Icons.Material.Filled.DoNotTouch)"
                                 Color="@(context.Item.HasFingerprint ? Color.Success : Color.Default)"
                                 Size="Size.Small" />
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.IsActive" Title="Status">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 Color="@(context.Item.IsActive ? Color.Success : Color.Default)">
                            @(context.Item.IsActive ? "Ativo" : "Inativo")
                        </MudChip>
                    </CellTemplate>
                </PropertyColumn>
            </Columns>
        </MudDataGrid>

        @if (_totalPages > 1)
        {
            <div class="d-flex align-center justify-space-between mt-4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @PageFirstRecord–@PageLastRecord de @_totalCount funcionários
                </MudText>
                <div class="d-flex align-center gap-2">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="@(_pageNumber <= 1 || _loading)"
                                   OnClick="@(() => ChangePageAsync(_pageNumber - 1))" aria-label="Página anterior" />
                    <MudText Typo="Typo.body2">Página @_pageNumber de @_totalPages</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="@(_pageNumber >= _totalPages || _loading)"
                                   OnClick="@(() => ChangePageAsync(_pageNumber + 1))" aria-label="Próxima página" />
                </div>
            </div>
        }    }
</MudPaper>

@code {
    private const int PageSize = 25;
    private List<EmployeeSummary> _employees = [];
    private string _search = "";
    private string _filter = "all";
    private bool _loading = true;
    private int _pageNumber = 1;
    private int _totalPages;
    private int _totalCount;
    private CancellationTokenSource? _searchCancellation;
    private int PageFirstRecord => _totalCount == 0 ? 0 : ((_pageNumber - 1) * PageSize) + 1;
    private int PageLastRecord => Math.Min(_pageNumber * PageSize, _totalCount);

    protected override Task OnInitializedAsync() => LoadPageAsync();

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
        _searchCancellation = new CancellationTokenSource();
        try
        {
            await Task.Delay(350, _searchCancellation.Token);
            _pageNumber = 1;
            await LoadPageAsync(_searchCancellation.Token);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task OnFilterChanged(string value)
    {
        _filter = value;
        _pageNumber = 1;
        await LoadPageAsync();
    }

    private async Task ChangePageAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _totalPages || pageNumber == _pageNumber)
            return;
        _pageNumber = pageNumber;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync(CancellationToken cancellationToken = default)
    {
        _loading = true;
        try
        {
            bool? isActive = _filter switch
            {
                "active" => true,
                "inactive" => false,
                _ => null
            };
            var page = await Api.GetPagedEmployeesAsync(
                State.BranchId,
                _pageNumber,
                PageSize,
                _search,
                isActive,
                cancellationToken: cancellationToken);
            _employees = page.Items.ToList();
            _totalPages = page.TotalPages;
            _totalCount = page.TotalCount;
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            Snackbar.Add("Erro ao carregar funcionários", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _searchCancellation?.Cancel();
        _searchCancellation?.Dispose();
    }

    private static string FormatDocument(DocumentInfo doc)
    {
        if (doc.Value.Length == 11)
            return $"{doc.Value[..3]}.{doc.Value[3..6]}.{doc.Value[6..9]}-{doc.Value[9..]}";
        return doc.Value;
    }

    private async Task ShowDominioMapping()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<DominioMappingDialog>("Mapeamento Domínio", options);
    }

    private async Task CopyInviteLinkAsync()
    {
        try
        {
            var invitation = await Api.GetCompanyJoinLinkAsync(State.BranchId);
            var link = $"{Navigation.BaseUri.TrimEnd('/')}/join?token={Uri.EscapeDataString(invitation.Token)}";
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", link);
            Snackbar.Add($"Convite copiado. Válido até {invitation.ExpiresAt:dd/MM HH:mm}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
