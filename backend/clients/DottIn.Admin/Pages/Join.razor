@page "/join"
@layout InvitationLayout
@implements IDisposable
@inject AdminApiClient Api
@inject AuthService Auth
@inject AdminState State
@inject CompanyJoinFlow JoinFlow
@inject CompanyJoinNotice JoinNotice
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Entrar na empresa – DottIn</PageTitle>

<div class="join-page">
    <MudPaper Class="pa-6 join-card" Elevation="2">
        <div class="join-logo"><DottInLogo Height="44" /></div>
        @if (_loadingLink)
        {
            <div class="join-status" role="status" aria-live="polite" aria-busy="true">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="mt-4">Verificando seu convite</MudText>
                <MudText Typo="Typo.body2" Class="mt-2">Estamos conferindo sua sessão e o acesso à empresa.</MudText>
            </div>
        }
        else if (_alreadyMember)
        {
            <div class="join-status" role="status" aria-live="polite">
                <div class="join-check"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Large" /></div>
                <MudText Typo="Typo.h5" Class="mt-4">Você já faz parte desta empresa!</MudText>
                <MudText Typo="Typo.body1" Class="mt-2">@_company?.CompanyName</MudText>
                <MudText Typo="Typo.body2" Class="mt-3 mb-4">Tudo certo com seu acesso. Abrindo seu dashboard…</MudText>
                <MudButton OnClick="OpenDashboard" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Ir para o dashboard</MudButton>
            </div>
        }
        else if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">@_loadError</MudAlert>
            <MudButton OnClick="LoadInviteAsync" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">Tentar novamente</MudButton>
        }
        else if (_company is null)
        {
            <MudText Color="Color.Error">Este link de convite é inválido ou expirou.</MudText>
        }
        else
        {
            <MudText Typo="Typo.h5" Class="mb-1">Entrar em @_company.CompanyName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Se já possui conta, faça login. Caso contrário, crie somente sua conta de funcionário.
            </MudText>

            <MudTabs Rounded="true" Elevation="0" @bind-ActivePanelIndex="_tab">
                <MudTabPanel Text="Já tenho conta">
                    <MudTextField @bind-Value="_cpf" Label="CPF" Mask="@(new PatternMask("000.000.000-00"))" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
                    <MudTextField T="string" @bind-Value="_password" Immediate="true" Label="Senha" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@_submitting" OnClick="LoginAsync">
                        Entrar
                    </MudButton>
                </MudTabPanel>
                <MudTabPanel Text="Criar conta">
                    @if (!_company.CanJoin)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">Não há assentos disponíveis para novos funcionários.</MudAlert>
                    }
                    <MudTextField T="string" @bind-Value="_name" Immediate="true" Label="Nome completo" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
                    <MudTextField @bind-Value="_cpf" Label="CPF" Mask="@(new PatternMask("000.000.000-00"))" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
                    <MudTextField T="string" @bind-Value="_password" Immediate="true" Label="Senha" HelperText="10+ caracteres com maiúscula, minúscula, número e símbolo" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" FullWidth="true" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="@(_submitting || !_company.CanJoin)" OnClick="RegisterAsync">
                        Criar conta e entrar
                    </MudButton>
                </MudTabPanel>
            </MudTabs>
        }
    </MudPaper>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    public string? InviteToken { get; set; }

    private string? _loadedToken;
    private CancellationTokenSource _lifetime = new();
    private bool _redirected;
    private bool _alreadyMember;
    private string? _loadError;
    private string _token = "";
    private string _name = "";
    private string _cpf = "";
    private string _password = "";
    private int _tab;
    private bool _loadingLink = true;
    private bool _submitting;
    private CompanyJoinLinkResolutionResponse? _company;

    protected override async Task OnParametersSetAsync()
    {
        var token = InviteToken ?? "";
        if (_loadedToken == token) return;
        _loadedToken = token;
        _token = token;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _lifetime = new CancellationTokenSource();
        _alreadyMember = false;
        _redirected = false;
        _submitting = false;
        _password = "";
        await LoadInviteAsync();
    }

    private async Task LoadInviteAsync()
    {
        var cancellationToken = _lifetime.Token;
        _loadingLink = true;
        _loadError = null;
        _company = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(_token))
            {
                var company = await JoinFlow.ResolveAsync(_token, cancellationToken);
                if (cancellationToken.IsCancellationRequested) return;
                _company = company;
            }
            _loadingLink = false;
            if (_company?.AlreadyMember == true)
                await ConfirmMembershipAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or ApiException or System.Text.Json.JsonException or OperationCanceledException)
        {
            if (!cancellationToken.IsCancellationRequested)
                _loadError = "Não foi possível verificar seu convite agora. Confira sua conexão e tente novamente.";
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested) _loadingLink = false;
        }
    }

    private async Task LoginAsync()
    {
        if (_submitting) return;
        var cancellationToken = _lifetime.Token;
        _submitting = true;
        try
        {
            var (success, alreadyMember, error) = await Auth.LoginFromCompanyJoinLinkAsync(CleanCpf(), _password, _token, cancellationToken);
            if (cancellationToken.IsCancellationRequested) return;
            if (!success)
                Snackbar.Add(error ?? "Não foi possível entrar.", Severity.Error);
            else if (alreadyMember)
                await ConfirmMembershipAsync(cancellationToken);
            else
                Navigation.NavigateTo("/dashboard", replace: true);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        finally
        {
            if (!cancellationToken.IsCancellationRequested) _submitting = false;
        }
    }

    private async Task RegisterAsync()
    {
        if (_submitting) return;
        var cancellationToken = _lifetime.Token;
        _submitting = true;
        try
        {
            var response = await Api.RegisterFromCompanyJoinLinkAsync(
                new RegisterFromCompanyJoinLinkRequest(_token, _name.Trim(), CleanCpf(), _password), cancellationToken);
            if (!response.Success)
            {
                Snackbar.Add(response.Error ?? "Não foi possível criar a conta.", Severity.Error);
                return;
            }

            var (success, _, error) = await Auth.LoginFromCompanyJoinLinkAsync(CleanCpf(), _password, _token, cancellationToken);
            if (cancellationToken.IsCancellationRequested) return;
            if (!success)
                Snackbar.Add(error ?? "A conta foi criada, mas o login não pôde ser concluído.", Severity.Error);
            else
                Navigation.NavigateTo("/dashboard", replace: true);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception exception) when (exception is HttpRequestException or ApiException or System.Text.Json.JsonException or OperationCanceledException)
        {
            if (!cancellationToken.IsCancellationRequested)
                Snackbar.Add("Não foi possível concluir o cadastro. Tente entrar com sua conta ou verifique sua conexão.", Severity.Error);
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested) _submitting = false;
        }
    }

    private async Task ConfirmMembershipAsync(CancellationToken cancellationToken)
    {
        _alreadyMember = true;
        _loadingLink = false;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromMilliseconds(1400), cancellationToken);
        OpenDashboard();
    }

    private void OpenDashboard()
    {
        if (_redirected || _lifetime.IsCancellationRequested || !State.IsSessionReady) return;
        _redirected = true;
        JoinNotice.Queue(State.EmployeeId);
        Navigation.NavigateTo("/dashboard", replace: true);
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private string CleanCpf() => new string(_cpf.Where(char.IsDigit).ToArray());
}

<style>
    .join-page { min-height: 100vh; display: grid; place-items: center; padding: 1rem; background: var(--mud-palette-background); }
    .join-card { width: min(100%, 480px); }
    .join-logo { display: flex; justify-content: center; margin-bottom: 1.5rem; }
    .join-status { text-align: center; padding: .75rem 0; }
    .join-check { display: grid; place-items: center; width: 80px; height: 80px; margin: 0 auto; border-radius: 50%; color: var(--mud-palette-success); background: var(--mud-palette-success-hover); border: 2px solid var(--mud-palette-success); }
</style>
