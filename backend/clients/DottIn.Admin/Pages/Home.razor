@page "/"
@inject AuthService AuthService
@inject AdminState State
@inject OperationalAccessService OperationalAccess
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>DottIn Admin - Login</PageTitle>

<style>
    .admin-login-container {
        position: relative;
        height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0B1120;
        font-family: 'Inter', sans-serif;
        padding: 16px;
    }

    .login-content-wrap {
        width: 100%;
        max-width: 360px; /* Corrigido de max-w para max-width */
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    /* Header Minimalista */
    .brand-logo-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .brand-wordmark {
        display: flex;
        align-items: baseline;
    }

    .brand-wordmark-text {
        font-size: 24px;
        font-weight: 700;
        color: #F8FAFC;
        letter-spacing: -0.5px;
    }

    .brand-wordmark-dot {
        font-size: 24px;
        font-weight: 800;
        color: #2563EB;
    }

    .brand-subtitle-text {
        font-size: 10px;
        font-weight: 600;
        color: #475569;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Card Sóbrio e Compacto */
    .login-card {
        background: #111827 !important;
        border: 1px solid #1E293B !important;
        border-radius: 16px !important;
    }

    /* Customização Clean dos Inputs MudBlazor */
    .admin-login-container .mud-input {
        color: #F8FAFC !important;
        background: #0B1120 !important;
    }

    .admin-login-container .mud-input-outlined-border {
        border-color: #1E293B !important;
        border-radius: 10px !important;
    }

    .admin-login-container .mud-input-control:hover .mud-input-outlined-border {
        border-color: #334155 !important;
    }

    .admin-login-container .mud-focused .mud-input-outlined-border {
        border-color: #2563EB !important;
        border-width: 1px !important;
    }

    .admin-login-container .mud-input-label {
        color: #475569 !important;
    }

    .admin-login-container .mud-focused .mud-input-label {
        color: #38BDF8 !important;
    }

    .admin-login-container .mud-input-adornment .mud-icon-root {
        color: #334155 !important;
    }

    .admin-login-container .mud-focused .mud-input-adornment .mud-icon-root {
        color: #2563EB !important;
    }

    /* Botão Sólido Minimalista */
    .btn-flat {
        background: #2563EB !important;
        color: #FFFFFF !important;
        border-radius: 10px !important;
        font-weight: 600 !important;
        text-transform: none !important;
        height: 44px !important;
        box-shadow: none !important;
        transition: background-color 0.2s ease;
    }

        .btn-flat:hover:not(:disabled) {
            background: #1D4ED8 !important;
        }
</style>

@if (State.IsAuthenticated)
{
    @if (State.CanAccessOperationalModules)
    {
        <DottIn.Admin.Pages.Dashboard />
    }
}
else
{
    <div class="admin-login-container">
        <div class="login-content-wrap">

            @* Identidade Visual Superior *@
            <div class="brand-logo-wrap">
                <div class="brand-wordmark">
                    <span class="brand-wordmark-text">Dott</span><span class="brand-wordmark-dot">In</span>
                </div>
                <div class="brand-subtitle-text">Painel Administrativo</div>
            </div>

            @* Formulário Corporativo *@
            <MudCard Class="login-card" Elevation="0">
                <MudCardContent Class="pa-6">

                    <MudTextField @bind-Value="_companyCode"
                                  Label="Empresa"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Business"
                                  FullWidth="true"
                                  Class="mb-3" />

                    <MudTextField @bind-Value="_cpf"
                                  Label="CPF"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Badge"
                                  FullWidth="true"
                                  Class="mb-3" />

                    <MudTextField @bind-Value="_password"
                                  Label="Senha"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showPwd? InputType.Text: InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPwd? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="() => _showPwd = !_showPwd"
                                  FullWidth="true"
                                  Class="mb-5" />

                    <MudButton Variant="Variant.Filled"
                               Class="btn-flat"
                               FullWidth="true"
                               Disabled="_loading"
                               OnClick="HandleLogin">
                        @if (_loading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Acessar Painel
                    </MudButton>

                    <div style="text-align: center; margin-top: 16px;">
                        <MudText Typo="Typo.body2" Style="color: #64748B;">
                            Não tem uma conta ainda? <MudLink Href="/register" Style="color: #2563EB; font-weight: 600; text-decoration: none;">Registre-se</MudLink>
                        </MudText>
                    </div>
                </MudCardContent>
            </MudCard>

            @* Rodapé *@
            <div style="text-align: center;">
                <MudText Typo="Typo.caption" Style="color: #334155;">
                    &copy; 2026 DottIn
                </MudText>
            </div>
        </div>
    </div>
}

@code {
    private string _companyCode = "";
    private string _cpf = "";
    private string _password = "";
    private bool _showPwd;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        if (State.IsAuthenticated)
        {
            if (!State.IsOperationalAccessResolved)
                await OperationalAccess.RefreshAsync();

            Navigation.NavigateTo(
                OperationalAccessPolicy.GetAuthenticatedDestination(State.CanAccessOperationalModules),
                replace: true);
            return;
        }

        // Auto-fill company code from ?empresa= query parameter (employee login link)
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var empresaParam = query["empresa"];
        if (!string.IsNullOrWhiteSpace(empresaParam))
        {
            _companyCode = empresaParam;
        }
    }

    private async Task HandleLogin()
    {
        _loading = true;
        var (success, error) = await AuthService.LoginAsync(_cpf, _password, _companyCode);
        if (success)
        {
            await OperationalAccess.RefreshAsync();
            Snackbar.Add("Login realizado com sucesso!", Severity.Success);
            Navigation.NavigateTo(
                OperationalAccessPolicy.GetAuthenticatedDestination(State.CanAccessOperationalModules),
                replace: true);
        }
        else
        {
            Snackbar.Add(error ?? "Erro ao fazer login", Severity.Error);
        }
        _loading = false;
    }
}