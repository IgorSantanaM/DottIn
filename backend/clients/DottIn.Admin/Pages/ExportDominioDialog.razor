@inject AdminApiClient Api
@inject AdminState State
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <div style="display: flex; align-items: center; gap: 8px;">
            <MudIcon Icon="@Icons.Material.Filled.FileDownload" />
            <MudText Typo="Typo.h6">Exportar Domínio</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Selecione o mês e informe o código interno da empresa no Domínio Folha.
        </MudText>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            Importe o arquivo no Domínio em Utilitários &gt; Importação &gt; Importar Lançamentos.
            Depois, execute o cálculo da folha no Domínio.
        </MudAlert>

        <MudDatePicker @bind-Date="_selectedMonth" Label="Mês de Referência"
                       Variant="Variant.Outlined" FullWidth="true"
                       OpenTo="OpenTo.Month" FixMonth="null"
                       DateFormat="MM/yyyy" />

        <MudTextField @bind-Value="_companyCode" Label="Código da empresa no Domínio"
                      Variant="Variant.Outlined" Margin="Margin.Normal"
                      Placeholder="ex: 1" MaxLength="10" InputType="InputType.Number"
                      HelperText="Use o código interno da empresa, com até 10 dígitos" />

        <MudExpansionPanels Elevation="0" Class="mt-2">
            <MudExpansionPanel Text="Configuração das rubricas">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_normalRubricCode" Label="Horas normais"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      MaxLength="4" InputType="InputType.Number" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_nocturnalRubricCode" Label="Adicional noturno"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      MaxLength="4" InputType="InputType.Number" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_holidayRubricCode" Label="Horas em feriado"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      MaxLength="4" InputType="InputType.Number" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_processType" Label="Tipo do processo"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      MaxLength="2" InputType="InputType.Number" />
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Confirme os códigos das rubricas no cadastro do seu Domínio antes da importação.
                </MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_exporting || _selectedMonth is null || string.IsNullOrWhiteSpace(_companyCode))" OnClick="Export"
                   StartIcon="@Icons.Material.Filled.FileDownload">
            @if (_exporting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Exportar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private DateTime? _selectedMonth = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);
    private string _companyCode = "";
    private string _normalRubricCode = "1";
    private string _nocturnalRubricCode = "150";
    private string _holidayRubricCode = "250";
    private string _processType = "11";
    private bool _exporting;

    private async Task Export()
    {
        if (_selectedMonth is null) return;
        _exporting = true;
        try
        {
            var month = _selectedMonth.Value.ToString("yyyy-MM");
            var bytes = await Api.ExportDominioAsync(
                State.BranchId,
                month,
                _companyCode.Trim(),
                _normalRubricCode.Trim(),
                _nocturnalRubricCode.Trim(),
                _holidayRubricCode.Trim(),
                _processType.Trim());

            if (bytes.Length == 0)
            {
                Snackbar.Add("Nenhum dado para exportar. Verifique os mapeamentos Domínio.", Severity.Warning);
                _exporting = false;
                return;
            }

            var filename = $"dominio_{_selectedMonth.Value:yyyyMM}.txt";
            await DownloadFile(bytes, filename, "text/plain");
            Snackbar.Add("Arquivo exportado!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro: {ex.Message}", Severity.Error);
        }
        _exporting = false;
    }

    private async Task DownloadFile(byte[] bytes, string filename, string contentType)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("eval", $@"
            var link = document.createElement('a');
            link.href = 'data:{contentType};base64,{base64}';
            link.download = '{filename}';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        ");
    }

    private void Cancel() => MudDialog.Cancel();
}
