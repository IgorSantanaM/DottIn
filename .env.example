# Production template. For local testing, run:
# ./backend/tools/Initialize-ComposeEnvironment.ps1
# This generates .env, selects compose.local.yaml and imports local Stripe test keys.
# Alternatively copy this file to .env and fill in the empty values for production.
# Use the public HTTPS origin without a trailing slash.
APP_PUBLIC_URL=https://app.example.com
API_ALLOWED_HOSTS=*

# Generate independent random, URL-safe secrets (e.g. openssl rand -hex 32).
# Hex values avoid escaping in PostgreSQL and RabbitMQ connection strings.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET=

# MassTransit 9 requires a license to start RabbitMQ messaging.
MT_LICENSE=
# MediatR also logs a production license requirement when this is unset.
MEDIATR_LICENSE_KEY=
# Set true only for a stack without background message processing.
MASSTRANSIT_DISABLED=false

# Existing Azure Blob Storage account; no local storage emulator is deployed.
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=employee-images

# All Stripe settings must belong to the same test/live account.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Initial startup applies the application's EF migrations and Free-plan seed.
APPLY_MIGRATIONS_ON_STARTUP=true

# Infrastructure ports are accessible only from this host by default.
TOOLS_BIND_ADDRESS=127.0.0.1
# Docker automatically allocates the network subnet to avoid conflicts.
